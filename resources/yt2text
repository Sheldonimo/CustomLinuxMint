#!/usr/bin/env bash
# yt2text.sh - Extract text from YouTube video subtitles
# Version: 3.0 - Improved and modularized
# by: Sheldonimo (improved version)

set -euo pipefail

# ============================================================================
# CONFIGURATION AND CONSTANTS
# ============================================================================

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Default configuration
readonly SCRIPT_NAME=$(basename "$0")
readonly SCRIPT_VERSION="3.0"
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/yt2text"
readonly DEFAULT_LANG=""

# Configuration variables
lang="$DEFAULT_LANG"
output_file=""
copy_to_clipboard=false
verbose=false
keep_timestamps=false
subtitle_preference="any"
list_languages=false
output_format="text"
use_cache=false
youtube_url=""
selected_sub_track=""  # Track global para de-rolling

# ============================================================================
# UTILITY FUNCTIONS
# ============================================================================

error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit "${2:-1}"
}

warning() {
    echo -e "${YELLOW}Warning: $1${NC}" >&2
}

info() {
    if [[ "$verbose" == true ]]; then
        echo -e "${BLUE}Info: $1${NC}" >&2
    fi
}

success() {
    echo -e "${GREEN}✓ $1${NC}" >&2
}

# ============================================================================
# HELP AND DEPENDENCIES
# ============================================================================

show_help() {
    cat << EOF
$SCRIPT_NAME v$SCRIPT_VERSION - Extract text from YouTube video subtitles

USAGE:
    $SCRIPT_NAME [OPTIONS] <YouTube_URL>

OPTIONS:
    -l, --lang LANG      Language code for subtitles (default: $DEFAULT_LANG)
    -o, --output FILE    Save output to file instead of stdout
    -c, --clipboard      Copy result to clipboard
    -v, --verbose        Enable verbose mode
    -t, --timestamps     Keep timestamps in output
    -m, --manual         Prefer manual subtitles over auto-generated
    -a, --auto           Force auto-generated subtitles only
    -L, --list-langs     List available subtitle languages and exit
    -f, --format FORMAT  Output format: text, srt, json (default: text)
    -C, --cache          Enable caching of results
    -h, --help           Show this help message

EXAMPLES:
    # Basic usage
    $SCRIPT_NAME https://www.youtube.com/watch?v=VIDEO_ID

    # Download Spanish subtitles and copy to clipboard
    $SCRIPT_NAME -l es -c https://youtu.be/VIDEO_ID

    # Save to file with timestamps
    $SCRIPT_NAME -o transcript.txt -t URL

    # Export as JSON with caching enabled
    $SCRIPT_NAME -f json -C -o data.json URL

EOF
    exit 0
}

check_dependencies() {
    local missing_deps=()
    
    if ! command -v yt-dlp &> /dev/null; then
        missing_deps+=("yt-dlp")
    fi
    
    if ! command -v jq &> /dev/null; then
        missing_deps+=("jq")
    fi
    
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        error "Missing required dependencies: ${missing_deps[*]}\nPlease install them first."
    fi
    
    info "All required dependencies are installed"
}

# ============================================================================
# URL HANDLING
# ============================================================================

validate_youtube_url() {
    local url="$1"
    local re='^https?://(www\.)?((youtube\.com/(watch\?v=[A-Za-z0-9_-]{11}|shorts/[A-Za-z0-9_-]{11}))|(m\.youtube\.com/watch\?v=[A-Za-z0-9_-]{11})|(youtu\.be/[A-Za-z0-9_-]{11}))'
    
    if [[ ! "$url" =~ $re ]]; then
        error "Invalid YouTube URL format: $url"
    fi
    
    info "URL validation passed"
}

get_video_id() {
    local url="$1"
    local video_id=""
    
    if [[ "$url" =~ [\?\&]v=([A-Za-z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    elif [[ "$url" =~ youtu\.be/([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    elif [[ "$url" =~ shorts/([a-zA-Z0-9_-]{11}) ]]; then
        video_id="${BASH_REMATCH[1]}"
    fi
    
    echo "$video_id"
}

# ============================================================================
# CACHE MANAGEMENT
# ============================================================================

get_cache_file() {
    local video_id="$1"
    local cache_key="${video_id}_${lang}_${subtitle_preference}_${output_format}"
    echo "$CACHE_DIR/${cache_key}.cache"
}

# ============================================================================
# CLIPBOARD HANDLING
# ============================================================================

get_clipboard_command() {
    # macOS
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "pbcopy"
    # Windows WSL
    elif grep -q Microsoft /proc/version 2>/dev/null; then
        echo "clip.exe"
    # Wayland
    elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy &> /dev/null; then
        echo "wl-copy"
    # X11
    elif [[ -n "${DISPLAY:-}" ]]; then
        if command -v xclip &> /dev/null; then
            echo "xclip -selection clipboard"
        elif command -v xsel &> /dev/null; then
            echo "xsel --clipboard --input"
        fi
    # Termux (Android)
    elif command -v termux-clipboard-set &> /dev/null; then
        echo "termux-clipboard-set"
    fi
}

copy_to_clipboard_func() {
    local text="$1"
    local clip_cmd
    clip_cmd=$(get_clipboard_command)
    
    if [[ -z "$clip_cmd" ]]; then
        warning "No clipboard tool found for your platform"
        return 1
    fi
    
    printf '%s' "$text" | eval "$clip_cmd"
    success "Text copied to clipboard using: $clip_cmd"
}

# ============================================================================
# SUBTITLE LANGUAGE SELECTION
# ============================================================================

list_available_languages() {
    local url="$1"
    
    info "Fetching available subtitle languages..."
    
    local langs
    langs=$(yt-dlp --list-subs "$url" 2>/dev/null | grep -E "^Language|^\w+" | grep -v "Available" || true)
    
    if [[ -z "$langs" ]]; then
        warning "No subtitles found for this video"
        exit 0
    fi
    
    echo -e "${GREEN}Available subtitle languages:${NC}"
    echo "$langs"
    exit 0
}

pick_sub_lang() {
    local url="$1"
    local user_lang="$2"
    local meta manual_keys auto_keys

    if ! meta="$(yt-dlp -J "$url" 2>/dev/null)"; then
        echo ""
        return 0
    fi

    manual_keys="$(jq -r '(.subtitles // {}) | keys[]? | select(test("live_chat")|not)' <<<"$meta")"
    auto_keys="$(jq -r '(.automatic_captions // {}) | keys[]? | select(test("live_chat")|not)' <<<"$meta")"

    # NUEVO: Respetar preferencia manual/auto
    case "$subtitle_preference" in
        manual) 
            auto_keys=""
            ;;
        auto)   
            manual_keys=""
            ;;
    esac

    _resolve_code() {
        local want="$1"
        local pool="$2"
        
        if printf '%s\n' "$pool" | grep -qx "$want"; then
            printf '%s' "$want"
            return 0
        fi
        
        local cand
        cand="$(printf '%s\n' "$pool" | awk -v w="$want" 'index($0,w"-")==1{print; exit}')"
        if [ -n "$cand" ]; then
            printf '%s' "$cand"
            return 0
        fi
        
        printf ''
    }

    if [ -n "$user_lang" ]; then
        local man="$(_resolve_code "$user_lang" "$manual_keys")"
        local aut="$(_resolve_code "$user_lang" "$auto_keys")"
        
        if [ -n "$man" ]; then
            printf '%s' "$man"
            return 0
        elif [ -n "$aut" ]; then
            printf 'a.%s' "$aut"
            return 0
        else
            printf ''
            return 0
        fi
    fi

    # Sin idioma del usuario: usa idioma "original"
    local auto_orig
    local _BAD_AUTO_RE='^(aa|und|mul|zxx|qx|xx)$'

    # Si hay solo un manual, úsalo
    if [ -n "$manual_keys" ]; then
        local one_manual="$(printf '%s\n' "$manual_keys" | wc -l | awk '{print $1}')"
        if [ "$one_manual" = "1" ]; then
            printf '%s\n' "$manual_keys"
            return 0
        fi
    fi

    # Priorizar idiomas comunes
    local prioritized_autos="$(printf '%s\n' "$auto_keys" \
        | grep -Ev "$_BAD_AUTO_RE" \
        | awk 'length($0)==2 || index($0,"es-")==1 || index($0,"pt-")==1 || index($0,"en-")==1')"

    for cand in es es-419 es-MX es-ES en en-US en-GB pt pt-BR; do
        if printf '%s\n' "$prioritized_autos" | grep -qx "$cand"; then
            auto_orig="$cand"
            break
        fi
    done

    [ -z "$auto_orig" ] && auto_orig="$(printf '%s\n' "$prioritized_autos" | awk 'length($0)==2{print; exit}')"
    [ -z "$auto_orig" ] && auto_orig="$(printf '%s\n' "$auto_keys" | grep -Ev "$_BAD_AUTO_RE" | head -n1)"
    [ -z "$auto_orig" ] && auto_orig="$(printf '%s\n' "$auto_keys" | head -n1)"

    if [ -n "$auto_orig" ]; then
        local man_same="$(_resolve_code "$auto_orig" "$manual_keys")"
        if [ -n "$man_same" ]; then
            printf '%s' "$man_same"
        else
            printf 'a.%s' "$auto_orig"
        fi
        return 0
    fi

    # Fallback al primer manual disponible
    local man_pick
    man_pick="$(printf '%s\n' "$manual_keys" | awk 'length($0)==2{print; exit}')"
    [ -z "$man_pick" ] && man_pick="$(printf '%s\n' "$manual_keys" | head -n1)"
    [ -n "$man_pick" ] && printf '%s' "$man_pick"
}

# ============================================================================
# SUBTITLE DOWNLOAD
# ============================================================================

download_subtitles() {
    local url="$1"
    local outbase="$2"
    
    selected_sub_track="$(pick_sub_lang "$url" "$lang")"
    
    if [[ -z "$selected_sub_track" ]]; then
        error "No subtitles available for the requested language${lang:+ ($lang)} or video's original language."
    fi
    
    info "Selected subtitle track: $selected_sub_track"
    
    local yt_dlp_opts=(
        --skip-download
        --convert-subs srt
        -o "${outbase}.%(ext)s"
    )
    
    case "$selected_sub_track" in
        a.*)
            yt_dlp_opts+=( --write-auto-sub --sub-langs "${selected_sub_track#a.}" )
            ;;
        *)
            yt_dlp_opts+=( --write-sub --sub-langs "$selected_sub_track" )
            ;;
    esac
    
    if [[ "$verbose" != true ]]; then
        yt_dlp_opts+=( --quiet --no-warnings )
    fi
    
    if ! yt-dlp "${yt_dlp_opts[@]}" "$url"; then
        error "Failed to download subtitles"
    fi
}

# ============================================================================
# SRT PROCESSING - SIMPLIFIED BUT ROBUST
# ============================================================================

# Remove overlapping text in auto-generated subtitles
remove_overlap() {
    local current="$1"
    local previous="$2"
    
    if [[ -z "$previous" ]] || [[ -z "$current" ]]; then
        echo "$current"
        return
    fi
    
    local max_check=60
    [[ ${#previous} -lt $max_check ]] && max_check=${#previous}
    
    # Check for overlapping text from 10 to max_check characters
    for (( i=$max_check; i>=10; i-- )); do
        local suffix="${previous: -$i}"
        local prefix="${current:0:$i}"
        
        if [[ "$suffix" == "$prefix" ]]; then
            echo "${current:$i}"
            return
        fi
    done
    
    echo "$current"
}

# Process SRT file - Simplified version
process_srt_file() {
    local srt_file="$1"
    
    if [[ ! -f "$srt_file" ]]; then
        error "Subtitle file not found: $srt_file"
    fi
    
    local is_auto=false
    [[ "$selected_sub_track" =~ ^a\. ]] && is_auto=true
    
    case "$output_format" in
        text)
            if [[ "$keep_timestamps" == true ]]; then
                # Text with timestamps - también quitar HTML tags
                awk '
                    /^[0-9]+$/ { next }
                    /^[0-9]{2}:[0-9]{2}:[0-9]{2}/ {
                        gsub(/\r/, "")
                        gsub(/,/, ".", $0)
                        split($0, t, /[[:space:]]*-->[[:space:]]*/)
                        print "[" t[1] " - " t[2] "]"
                        next
                    }
                    /^$/ { next }
                    { 
                        gsub(/\r/, "")
                        gsub(/<[^>]*>/, "")  # Quitar HTML tags también con timestamps
                        print 
                    }
                ' "$srt_file"
            else
                # Plain text - ALGORITMO DE-ROLLING MEJORADO
                if [[ "$is_auto" == true ]]; then
                    # Para subtítulos automáticos, usar AWK con de-rolling mejorado
                    awk '
                        /^[0-9]+$/ { next }
                        /^[0-9]{2}:[0-9]{2}:[0-9]{2}/ { next }
                        /^$/ { next }
                        
                        {
                            gsub(/\r/, "")
                            gsub(/<[^>]*>/, "")
                            gsub(/^[[:space:]]+|[[:space:]]+$/, "")
                            
                            if ($0 == "") next
                            
                            line = $0
                            
                            # De-rolling: buscar solapamiento con el texto previo
                            if (prev != "") {
                                # Limitar la ventana de búsqueda
                                prev_len = length(prev)
                                line_len = length(line)
                                max_overlap = (prev_len < 60) ? prev_len : 60
                                
                                # Buscar el mayor solapamiento posible
                                best_overlap = 0
                                for (k = max_overlap; k >= 10; k--) {
                                    if (k > line_len) continue
                                    
                                    # Comparar el final del texto previo con el inicio del actual
                                    suffix = substr(prev, prev_len - k + 1, k)
                                    prefix = substr(line, 1, k)
                                    
                                    if (suffix == prefix) {
                                        best_overlap = k
                                        break
                                    }
                                }
                                
                                # Si encontramos solapamiento, recortar
                                if (best_overlap > 0) {
                                    line = substr(line, best_overlap + 1)
                                }
                                
                                # Evitar duplicados completos
                                if (line == prev || line == "") next
                            }
                            
                            # Acumular el texto
                            if (out != "" && line != "") {
                                out = out " " line
                            } else if (line != "") {
                                out = line
                            }
                            
                            # Actualizar el buffer previo
                            prev = (length(line) > 120) ? substr(line, length(line) - 119) : line
                        }
                        
                        END {
                            gsub(/  +/, " ", out)
                            print out
                        }
                    ' "$srt_file"
                else
                    # Para subtítulos manuales, no aplicar de-rolling
                    awk '
                        /^[0-9]+$/ { next }
                        /^[0-9]{2}:[0-9]{2}:[0-9]{2}/ { next }
                        /^$/ { next }
                        
                        {
                            gsub(/\r/, "")
                            gsub(/<[^>]*>/, "")
                            gsub(/^[[:space:]]+|[[:space:]]+$/, "")
                            
                            if ($0 != "") {
                                if (out != "") out = out " "
                                out = out $0
                            }
                        }
                        
                        END {
                            gsub(/  +/, " ", out)
                            print out
                        }
                    ' "$srt_file"
                fi
            fi
            ;;
            
        srt)
            # Return original SRT format (just clean CRLF)
            sed 's/\r$//' "$srt_file"
            ;;
            
        json)
            # Convert to JSON format
            awk '
                function escape_json(s) {
                    gsub(/\\/, "\\\\", s)
                    gsub(/"/, "\\\"", s)
                    gsub(/\r/, "", s)
                    gsub(/\n/, "\\n", s)
                    gsub(/\t/, "\\t", s)
                    return s
                }
                
                BEGIN { 
                    print "["
                    first = 1
                    in_block = 0
                    seq = ""
                    start = ""
                    end = ""
                    text = ""
                }
                
                /^[0-9]+$/ {
                    if (in_block && seq != "") {
                        # Output previous block
                        if (!first) print ","
                        first = 0
                        printf "  {\"seq\": %s, \"start\": \"%s\", \"end\": \"%s\", \"text\": \"%s\"}", 
                               seq, start, end, escape_json(text)
                    }
                    seq = $0
                    in_block = 1
                    text = ""
                    next
                }
                
                /^[0-9]{2}:[0-9]{2}:[0-9]{2}/ {
                    gsub(/\r/, "")
                    split($0, times, / *--> */)
                    start = times[1]
                    end = times[2]
                    next
                }
                
                /^$/ { next }
                
                {
                    gsub(/\r/, "")
                    gsub(/<[^>]*>/, "")
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "")
                    if ($0 != "") {
                        if (text != "") text = text " "
                        text = text $0
                    }
                }
                
                END {
                    if (in_block && seq != "") {
                        if (!first) print ","
                        printf "  {\"seq\": %s, \"start\": \"%s\", \"end\": \"%s\", \"text\": \"%s\"}", 
                               seq, start, end, escape_json(text)
                    }
                    print "\n]"
                }
            ' "$srt_file" | jq '.'
            ;;
            
        *)
            error "Unknown output format: $output_format"
            ;;
    esac
}

# ============================================================================
# ARGUMENT PARSING
# ============================================================================

parse_arguments() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -l|--lang)
                lang="${2:-}"
                [[ -z "$lang" ]] && error "Language code required for $1"
                shift 2
                ;;
            -o|--output)
                output_file="${2:-}"
                [[ -z "$output_file" ]] && error "Output file required for $1"
                shift 2
                ;;
            -c|--clipboard)
                copy_to_clipboard=true
                shift
                ;;
            -v|--verbose)
                verbose=true
                shift
                ;;
            -t|--timestamps)
                keep_timestamps=true
                shift
                ;;
            -m|--manual)
                subtitle_preference="manual"
                shift
                ;;
            -a|--auto)
                subtitle_preference="auto"
                shift
                ;;
            -L|--list-langs)
                list_languages=true
                shift
                ;;
            -f|--format)
                output_format="${2:-}"
                [[ -z "$output_format" ]] && error "Format required for $1"
                [[ ! "$output_format" =~ ^(text|srt|json)$ ]] && \
                    error "Invalid format: $output_format. Must be text, srt, or json"
                shift 2
                ;;
            -C|--cache)
                use_cache=true
                shift
                ;;
            -h|--help)
                show_help
                ;;
            -*)
                error "Unknown option: $1\nUse -h for help"
                ;;
            *)
                youtube_url="$1"
                shift
                ;;
        esac
    done
    
    if [[ -z "$youtube_url" ]]; then
        error "No YouTube URL provided\nUse -h for help"
    fi
}

# ============================================================================
# MAIN FUNCTION
# ============================================================================

main() {
    parse_arguments "$@"
    
    # Validate URL
    validate_youtube_url "$youtube_url"
    
    # Handle list languages option
    if [[ "$list_languages" == true ]]; then
        list_available_languages "$youtube_url"
    fi
    
    # Check dependencies
    check_dependencies
    
    # Setup cache directory if needed
    if [[ "$use_cache" == true ]]; then
        mkdir -p "$CACHE_DIR"
        info "Cache directory: $CACHE_DIR"
    fi
    
    # Get video ID for caching
    local video_id
    video_id=$(get_video_id "$youtube_url")
    
    # Check cache if enabled
    local result=""
    if [[ "$use_cache" == true ]] && [[ -n "$video_id" ]]; then
        local cache_file
        cache_file=$(get_cache_file "$video_id")
        
        if [[ -f "$cache_file" ]]; then
            info "Using cached result from: $cache_file"
            result=$(cat "$cache_file")
        fi
    fi
    
    # Download and process if not cached
    if [[ -z "$result" ]]; then
        # Create temporary directory
        local temp_dir
        temp_dir=$(mktemp -d)
        trap "rm -rf '$temp_dir'" EXIT
        
        local temp_file="$temp_dir/subtitle"
        
        info "Downloading subtitles..."
        
        # Download subtitles
        download_subtitles "$youtube_url" "$temp_file"
        
        # Find the SRT file
        local srt_file
        srt_file=$(find "$temp_dir" -name "*.srt" -type f | head -1)
        
        if [[ -z "$srt_file" ]] || [[ ! -f "$srt_file" ]]; then
            error "No subtitle file found after download"
        fi
        
        info "Processing subtitle file: $(basename "$srt_file")"
        
        # Process the SRT file
        result=$(process_srt_file "$srt_file")
        
        # Save to cache if enabled
        if [[ "$use_cache" == true ]] && [[ -n "$video_id" ]]; then
            local cache_file
            cache_file=$(get_cache_file "$video_id")
            echo "$result" > "$cache_file"
            info "Result cached to: $cache_file"
        fi
    fi
    
    # Handle output
    if [[ -n "$output_file" ]]; then
        echo "$result" > "$output_file"
        success "Output saved to: $output_file"
    else
        echo "$result"
    fi
    
    # Copy to clipboard if requested
    if [[ "$copy_to_clipboard" == true ]]; then
        copy_to_clipboard_func "$result"
    fi
    
    success "Process completed successfully"
}

# ============================================================================
# SCRIPT ENTRY POINT
# ============================================================================

# Run main function with all arguments
main "$@"