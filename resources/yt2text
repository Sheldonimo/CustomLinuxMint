    cat << EOF
$SCRIPT_NAME v$SCRIPT_VERSION - Extract text from YouTube video subtitles

USAGE:
    $SCRIPT_NAME [OPTIONS] <YouTube_URL>

OPTIONS:
    -l, --lang LANG      Language code for subtitles (default: $DEFAULT_LANG)
